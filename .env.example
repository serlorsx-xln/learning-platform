# Platform Control Dashboard — environment template
# Copy to .env and fill in values before running docker compose

# Web app
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32-byte hex key — generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Shared secret between web and workers
INTERNAL_API_KEY=

# Bootstrap admin (created on first startup if user does not exist)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# Database (SQLite file inside Docker volume)
DATABASE_URL=file:/app/data/platform.db

# Internal callback base URL (compose service name in Docker network)
INTERNAL_CALLBACK_URL=http://app:3000

# Worker URLs (Docker internal network)
WORKER_ANDREWBIGGS_URL=http://worker-andrewbiggs:8001
WORKER_EDLEARNING_URL=http://worker-edlearning:8002
WORKER_SPEEXX_URL=http://worker-speexx:8003

# Local dev: bind address for docker-compose.local.yml
WEB_BIND=0.0.0.0

# Worker concurrency (job slots per worker container)
MAX_CONCURRENT_JOBS=5
# EdLearning parallel API calls inside one job (worker-edlearning only)
MAX_CONCURRENT=100
